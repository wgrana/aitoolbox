# Direct OpenAI or OpenAI-compatible endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Future LiteLLM example
# OPENAI_BASE_URL=http://localhost:4000/v1
# OPENAI_MODEL=openai/gpt-4.1-mini
# OPENAI_API_KEY=<litellm-key>

# AI Guard mode requires an external AI Guard-style API/proxy integration.
AI_GUARD_API_BASE_URL=https://api.zseclipse.net
AI_GUARD_API_KEY=
AI_GUARD_POLICY_ID=
# DAS/API direction enum mapping observed for execute-policy:
# IN = request/prompt inspection, OUT = response/output inspection.
# Override only if your tenant/API contract differs.
AI_GUARD_PROMPT_DIRECTION=IN
AI_GUARD_RESPONSE_DIRECTION=OUT

APP_MODE=local
